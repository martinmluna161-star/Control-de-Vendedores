# Copiá este archivo a ".env" y completá con los datos reales.
# En Render, estas mismas variables se cargan en Settings -> Environment (no como archivo).

# Connection string de Postgres de Supabase (Project Settings -> Database -> Connection string -> URI).
# Podés pegarla tal cual empiece con "postgresql://" o "postgres://", el backend la adapta solo.
DATABASE_URL=postgresql://postgres:TU_PASSWORD@db.xxxxxxxxxxxx.supabase.co:5432/postgres

# Project Settings -> API -> Project URL
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Project Settings -> API -> JWT Settings -> JWT Secret
SUPABASE_JWT_SECRET=

# Dominios permitidos para llamar a la API (separados por coma). En producción,
# poné acá la URL de GitHub Pages del frontend. "*" solo para probar en local.
CORS_ORIGINS=*
